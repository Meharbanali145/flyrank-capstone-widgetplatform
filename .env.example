# Copy to .env and adjust. NEVER commit .env. All values below are safe placeholders.

# --- app ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# false = ignore X-Forwarded-For (prevents spoofed IPs dodging rate limits)
TRUST_PROXY=false

# --- database ---
DATABASE_URL=postgres://widget:widget@localhost:5432/widgetplatform

# --- validation / abuse ---
MAX_BODY_BYTES=10240
RATE_LIMIT_IP_PER_MIN=10
RATE_LIMIT_WIDGET_PER_MIN=60

# --- geo enrichment (chain order = fallback order) ---
GEO_PROVIDER_ORDER=ip-api,ipapi-co
GEO_TIMEOUT_MS=1500
GEO_IP_API_URL=http://ip-api.com/json
GEO_IPAPI_CO_URL=https://ipapi.co
# used only by the deterministic fallback proof
GEO_MOCK_A_URL=http://localhost:4001
GEO_MOCK_B_URL=http://localhost:4002

# --- side effects ---
EMAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
# set true to prove that a failing email never blocks a submission (Probe 5)
FORCE_EMAIL_FAIL=false
JOB_POLL_MS=2000
JOB_MAX_ATTEMPTS=5

# --- demo seed (dev-only keys; the seed script hashes them before storing) ---
SEED_TENANT_A_API_KEY=dev-key-tenant-a-change-me
SEED_TENANT_B_API_KEY=dev-key-tenant-b-change-me
