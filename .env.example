NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

DATABASE_URL=postgres://widget:widget@localhost:5432/widgetplatform

MAX_BODY_BYTES=10240
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_WIDGET_MAX=100

GEO_PROVIDER_ORDER=ip-api,ipapi-co
GEO_TIMEOUT_MS=1500
GEO_MODE=mock

EMAIL_MODE=console
FORCE_EMAIL_FAIL=false
JOB_POLL_MS=2000
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_S=5

# openssl rand -hex 16 (or any random string >=16 chars)
SEED_TENANT_A_API_KEY=replace-me-tenant-a
SEED_TENANT_B_API_KEY=replace-me-tenant-b

# openssl rand -hex 16 (min 8 chars) -- gates /__control/*, must never be true in production
CONTROL_TOKEN=replace-me-control-token
ENABLE_TEST_CONTROLS=true
